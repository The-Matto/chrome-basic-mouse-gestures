{
    "name": "Matto - Chrome Mouse Gestures",
    "description": "Adds basic mouse gestures, one for each cardinal direction",
    "version": "1.0",
    "manifest_version": 3,
    "icons": {
        "128": "icons/icon128.png"
    },
    "action": {
        "default_popup": "source/popup.html"
    },
    "permissions": [
        "storage",
        "tabs",
        "sessions"
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "source/overlayWidget.html",
                "widget.css"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ],
    "background": {
        "service_worker": "source/background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "source/content.js"
            ],
            "css": [
                "source/styles.css"
            ],
            "html": [
                "source/overlayWidget.html"
            ],
            "run_at": "document_start"
        }
    ]
}